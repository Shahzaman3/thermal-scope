# ==============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and configure your keys
# ==============================================================================

# Backend FastAPI Service Base URL
VITE_API_URL=http://127.0.0.1:8000

# CARTO Basemaps API Key (Optional)
# If left blank, the application uses CARTO's default public tile access.
# If provided, the key is automatically appended to basemap tile requests (?api_key=...)
VITE_CARTO_API_KEY=
