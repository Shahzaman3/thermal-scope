# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and configure your keys
# ==============================================================================

# NASA FIRMS MAP_KEY for satellite fire ingestion
# Required only if running live data ingestion (free from https://firms.modaps.eosdis.nasa.gov/api/)
FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY

# Target Corridor Bounding Box: west,south,east,north (Jamshedpur–Odisha default)
FIRMS_BBOX=84.5,20.5,86.8,23.2

# Default observation window in days (1 to 5)
FIRMS_DEFAULT_DAYS=2

# Default satellite sensor: ALL, VIIRS_SNPP_NRT, VIIRS_NOAA20_NRT, or MODIS_NRT
FIRMS_DEFAULT_SOURCE=ALL

# Local SQLite Database File (Defaults to backend/data/thermal_classifier.db)
DATABASE_URL=sqlite:///data/thermal_classifier.db

# ==============================================================================
# PHASE 4C.1: AUTOMATED FIRMS MONITORING & REFRESH CONFIGURATION
# ==============================================================================
# Enables recurring background monitoring loop via FastAPI lifespan
# Default: false (preserves offline-first demo mode and prevents unexpected API calls)
FIRMS_AUTO_REFRESH_ENABLED=false

# Auto-refresh cycle interval in minutes (minimum safe interval is 60 minutes)
FIRMS_AUTO_REFRESH_INTERVAL_MINUTES=60
